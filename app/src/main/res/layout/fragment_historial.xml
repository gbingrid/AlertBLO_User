<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/android:windowBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" >

    <TextView
        android:id="@+id/historial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/txt_historial_alertas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:paddingTop="14dp"
        android:textColor="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/btn_salir"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/txt_salir"
        android:src="@drawable/ic_salir"
        app:tint="?attr/colorOnSurfaceVariant" />

    </RelativeLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp" >

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTodas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_todas"
            android:textColor="@color/chip_texto_selector"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            app:chipIconTint="@color/azul"
            app:chipBackgroundColor="@color/chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlertaCritica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_critica"
            android:textColor="@color/chip_texto_selector"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            app:chipIconTint="@color/azul"
            app:chipBackgroundColor="@color/chip_selector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlertaNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_aviso"
            android:textColor="@color/chip_texto_selector"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            app:chipIconTint="@color/azul"
            app:chipBackgroundColor="@color/chip_selector" />

    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:id="@+id/contenedor_lista_historial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>